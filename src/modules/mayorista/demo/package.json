{
  "name": "sigo-mayorista-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node ../tests/browser.mjs",
    "test:unit": "node ../tests/unit.mjs",
    "test:security": "node ../tests/security.mjs && node ../tests/role-policy.mjs && node ../tests/railway-policy.mjs && node ../tests/railway-tls.mjs && node ../tests/startup-diagnostic.mjs && node ../tests/bootstrap-identity.mjs && node ../tests/provision-qa-cli.mjs && node ../tests/prepare-or-check-qa.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.mayorista.json",
    "test:admin": "node ../tests/admin.mjs && node ../tests/cargas.mjs && node ../tests/presentation-loads.mjs",
    "test:recovery": "node ../tests/recovery-unit.mjs",
    "test:integration-pwa": "node ../tests/integration-pwa.mjs",
    "test:http-auth": "node ../tests/http-auth.mjs",
    "test:rendiciones": "node ../tests/rendiciones.mjs",
    "test:rls": "node ../tests/rls-ci.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/react": "19.1.10"
  }
}
